# Alpha Agora environment sample
# Copy this file to .env.local and fill only the values you want to enable.
# Never commit .env.local or real secrets.

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# demo: use deterministic/mock adapters when provider credentials are missing
# production: require real provider credentials for enabled integrations
ALPHA_AGORA_MODE=demo

# -----------------------------------------------------------------------------
# LLM generator — Gemini
# -----------------------------------------------------------------------------
# Implemented through Vercel AI SDK packages `ai` + `@ai-sdk/google`.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional alias also supported by @ai-sdk/google conventions.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Arc Testnet — trace commit / on-chain proof
# -----------------------------------------------------------------------------
# Arc Testnet docs: https://docs.arc.network/arc/references/connect-to-arc
# Faucet for testnet USDC gas: https://faucet.circle.com
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_EXPLORER_URL=https://testnet.arcscan.app
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Use a brand-new hackathon/test wallet only. Do not use a main wallet.
ARC_COMMITTER_PRIVATE_KEY=

# Leave blank if we should deploy our own demo TraceRegistry contract.
# Fill with an official/provided TraceRegistry contract address if the hackathon gives one.
ARC_TRACE_REGISTRY_ADDRESS=

# Validator reward recipient address for Arc USDC transfer demo.
REWARD_RECIPIENT_ADDRESS=

# -----------------------------------------------------------------------------
# Circle Developer-Controlled Wallets — optional advanced settlement path
# -----------------------------------------------------------------------------
# Use this only if we decide to settle rewards through Circle Wallets API/SDK
# instead of direct Arc USDC transfer.
# Circle console: https://console.circle.com/
# Docs: https://developers.circle.com/wallets/dev-controlled/entity-secret-management
CIRCLE_ENV=sandbox
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_USDC_TOKEN_ID=
CIRCLE_RECIPIENT_ADDRESS=

# -----------------------------------------------------------------------------
# Safety toggles
# -----------------------------------------------------------------------------
# Keep false unless intentionally sending real production funds.
ALLOW_MAINNET_TRANSFERS=false
# Optional per-reward safety cap in USDC.
MAX_REWARD_USDC=1
